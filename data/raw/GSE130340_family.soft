^SAMPLE = GSM3736416
!Sample_title = ES cells 1
!Sample_geo_accession = GSM3736416
!Sample_status = Public on Feb 23 2021
!Sample_submission_date = Apr 25 2019
!Sample_last_update_date = Feb 23 2021
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = ES cells
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell type: mel1
!Sample_characteristics_ch1 = genotype: WT
!Sample_growth_protocol_ch1 = Human Embryonic Stem Cells were cultured with TesR-E8 medium (Stemcell Techologies) in Matrigel-coated plates. Endoderm cells were induced by the endoderm differentiation kit (STEMdiff Trilineage Differentiation kit, Stemcell Technologies)
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA was extracted by RNeasy miniprep kit (Qiagen).
!Sample_extract_protocol_ch1 = Illumina TruSeq RNA Sample Prep Kit (Cat#FC-122-1001) was used with 1 ug of total RNA for the construction of sequencing libraries.
!Sample_description = YFR1
!Sample_data_processing = Illumina’s bcl2fastq was used to convert bcl files to FASTQ files and de-multiplex the samples.
!Sample_data_processing = Reads were filtered based on a mean base quality score > 20, and adapters were trimmed by “trim_galore” (version 0.4). Trimmed reads were mapped to hg19 using STAR aligner (version 2.6) separately. Subread featureCounts (version 1.4.6) was applied for gene quantification based on UCSC hg19 RefSeq gene release (downloaded August 18th, 2017).
!Sample_data_processing = Genome_build: hg19
!Sample_data_processing = Supplementary_files_format_and_content: tab-delimited text files include raw read count or log2 transformed DESeq2 normalized counts for each sample
